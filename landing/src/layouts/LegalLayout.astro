---
import BaseLayout from "./BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Logo from "../components/Logo.astro";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <header class="border-b border-border-subtle">
    <div class="shell flex h-20 items-center">
      <a href="/" aria-label="PostStack home"><Logo /></a>
    </div>
  </header>
  <main id="main" class="legal">
    <div class="shell">
      <slot />
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .legal {
    padding: 3rem 0 5rem;
    overflow-wrap: anywhere;
  }
  .legal :global(h1) {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink, #f4f4f7);
  }
  .legal :global(.legal-meta) {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-ink-3, #8b8b96);
  }
  .legal :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-ink, #f4f4f7);
  }
  .legal :global(p) {
    margin-top: 0.75rem;
    max-width: 70ch;
    line-height: 1.7;
    color: var(--color-ink-2, #c4c4cf);
  }
  .legal :global(a) {
    color: var(--color-blue, #5b8cff);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal :global(a:hover) {
    color: var(--color-ink, #f4f4f7);
  }
  .legal :global(code) {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.85em;
    overflow-wrap: anywhere;
    color: var(--color-ink, #f4f4f7);
  }
  .legal :global(.cookie-table-scroll) {
    margin-top: 1.25rem;
    overflow-x: auto;
  }
  .legal :global(.cookie-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .legal :global(.cookie-table th),
  .legal :global(.cookie-table td) {
    border: 1px solid var(--color-border-subtle, #26262f);
    padding: 0.55rem 0.7rem;
    text-align: left;
    vertical-align: top;
    color: var(--color-ink-2, #c4c4cf);
  }
  .legal :global(.cookie-table th) {
    color: var(--color-ink, #f4f4f7);
    font-weight: 600;
  }
  .legal :global(.legal-back) {
    margin-top: 3rem;
  }
  .legal :global(ul) {
    margin-top: 0.75rem;
    padding-left: 1.5rem;
    list-style: disc;
    max-width: 70ch;
    line-height: 1.7;
    color: var(--color-ink-2, #c4c4cf);
  }
</style>
